# ローカルの秘密情報・機密資料はGitへコミットしない
.env
.env.*
!.env.example
!.env.sample
**/auth.json
**/.claude/**
**/.codex/**
**/.ssh/**
**/.aws/**
**/.config/gcloud/**
**/credentials.json
**/secrets.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# 実際の原本・音声・データベース・一時保存データ・バックアップを除外する
/originals/
/revisions/
/derived/
/runtime/
/data/
/backups/
/recovery/
/uploads/
/media/
/local-data/
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.kdbx
*.m4a
*.aac
*.mp3
*.wav
*.caf
*.mp4

# 依存パッケージ・ビルド成果物・キャッシュを除外する
node_modules/
dist/
build/
coverage/
.next/
.vite/
.turbo/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.log
.DS_Store
Thumbs.db

# エディターや開発環境のローカル設定を除外する
.vscode/
.idea/
